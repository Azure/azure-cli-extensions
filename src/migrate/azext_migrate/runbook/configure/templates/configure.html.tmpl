<!DOCTYPE html>
<!--
  Generated by `az migrate runbook parameter configure` /
  `az migrate runbook execution parameter configure`.
  Static, offline, no backend. Visualizer look; vertical tab per step.
  Layout: left = steps; middle = the step inputs (used for every workload);
  right-top = PER-WORKLOAD overrides (pick a workload, edit any of its inputs;
  blank = inherit the step input); right = JSON tab.
  Fields + validation are driven by the `schema` rules in inputs.json. The
  page cannot call the CLI, so saving writes ./inputs.json and shows the
  `parameter upload` command to run.
-->
<html lang="en">
<head>
<meta charset="utf-8" />
<meta http-equiv="Content-Security-Policy" content="default-src 'none'; connect-src 'none'; img-src data:; style-src 'unsafe-inline'; base-uri 'none'; form-action 'none'; script-src 'nonce-__CSP_NONCE__';" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Parameter configure &ndash; Migrate runbook</title>
<style>
  :root {
    --brand: #0f6cbd; --brand-ink: #0c5aa0; --brand-soft: #eff6fc;
    --bg: #f3f3f2; --surface: #ffffff; --sunken: #f7f7f6;
    --hair: #eaeae8; --hair2: #dadad7;
    /* --faint and --field-border are the AA floors: 4.5:1 text, 3:1 control edge */
    --ink: #1d1d1b; --muted: #5a5a58; --faint: #6b6b68; --field-border: #8a8a87;
    --ok: #0e700e; --err: #b3261e; --warn: #8a5a00; --ovr: #0f6b4f;
    --sans: "Segoe UI", "Segoe UI Web (West European)", -apple-system, BlinkMacSystemFont,
      Roboto, "Helvetica Neue", sans-serif;
    --mono: Consolas, "Courier New", Courier, monospace;
    /* Fluent 2 type ramp: Caption2 / Caption1 / Body1 / Subtitle2 / Subtitle1 */
    --fs-100: 10px; --lh-100: 14px;
    --fs-200: 12px; --lh-200: 16px;
    --fs-300: 14px; --lh-300: 20px;
    --fs-400: 16px; --lh-400: 22px;
    --fs-500: 20px; --lh-500: 26px;
    --fw-reg: 400; --fw-semi: 600;
    --r: 6px;
  }
  * { box-sizing: border-box; }
  button, input, select, textarea, option { font-family: var(--sans); }
  option { font-size: var(--fs-300); }
  [hidden] { display: none !important; }
  .sr-only { position: absolute; width: 1px; height: 1px; margin: -1px; padding: 0;
    overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }
  html { height: 100%; overflow: hidden; }
  body { margin: 0; font-family: var(--sans); background: var(--bg); color: var(--ink);
    font-size: var(--fs-300); line-height: var(--lh-300); -webkit-font-smoothing: antialiased;
    display: flex; flex-direction: column;
    height: 100vh; height: 100dvh; overflow: hidden; }

  /* ---------- bands ---------- */
  .azure-bar { display: flex; align-items: center; gap: 10px; height: 40px; padding: 0 20px;
    background: #0b2545; color: #fff; flex: none; }
  .azure-bar__brand { font-size: var(--fs-300); line-height: var(--lh-300); font-weight: var(--fw-semi); }
  .azure-bar .pill { margin-left: auto; font-size: var(--fs-200); line-height: var(--lh-200);
    color: #cbd7e6; white-space: nowrap;
    border: 1px solid rgba(255,255,255,.18); border-radius: 10px; padding: 3px 10px; }

  .topbar { display: flex; align-items: flex-start; justify-content: space-between; gap: 24px;
    flex-wrap: wrap; padding: 13px 20px 12px; background: var(--surface);
    border-bottom: 1px solid var(--hair); flex: none; }
  .eyebrow { font-size: var(--fs-200); line-height: var(--lh-200); color: var(--faint); }
  .topbar h1 { margin: 1px 0 0; font-size: var(--fs-400); line-height: var(--lh-400);
    font-weight: var(--fw-semi); }
  .crumbs { display: flex; flex-wrap: wrap; align-items: baseline; gap: 2px 20px; margin-top: 6px;
    font-size: var(--fs-200); line-height: var(--lh-200); color: var(--muted); }
  .crumbs .k { color: var(--faint); }
  .crumbs b { font-weight: var(--fw-semi); color: var(--ink); }
  .acts { display: flex; align-items: center; gap: 8px; flex: none; padding-top: 8px; }

  .btn { font: inherit; font-size: var(--fs-300); line-height: var(--lh-300); cursor: pointer;
    border-radius: 4px; border: 1px solid var(--brand); background: var(--brand); color: #fff;
    padding: 5px 14px; }
  .btn:hover { background: var(--brand-ink); border-color: var(--brand-ink); }
  .btn.ghost { background: var(--surface); color: var(--ink); border-color: var(--hair2); }
  .btn.ghost:hover { background: var(--sunken); }
  /* transient copy confirmation shown on the button itself (visible inside popovers) */
  .btn.copied, .btn.copied:hover { background: #f1f8f1; border-color: #cfe4cf; color: var(--ok); }
  .btn.copyfail, .btn.copyfail:hover { background: #fdf4f4; border-color: #f0cfcf; color: var(--err); }
  .btn.sm { padding: 3px 9px; font-size: var(--fs-200); line-height: var(--lh-200); }
  .btn:disabled { opacity: .45; cursor: not-allowed; }

  .statusbar { display: flex; align-items: center; gap: 20px; flex-wrap: wrap;
    padding: 6px 20px; background: var(--surface); border-bottom: 1px solid var(--hair); flex: none; }
  .vsummary { display: inline-flex; align-items: center; gap: 7px;
    font-size: var(--fs-300); line-height: var(--lh-300);
    color: var(--muted); cursor: default; border-radius: 4px; padding: 2px 7px; margin-left: -7px; }
  .vsummary[role="button"] { cursor: pointer; }
  .vsummary[role="button"]:hover { background: var(--sunken); }
  .vsummary__act { color: var(--brand); text-decoration: underline; }
  .vsummary.bad2 { color: var(--err); }
  .vsummary.good { color: var(--ok); }
  .keys { display: flex; gap: 16px; flex-wrap: wrap; margin-left: auto;
    font-size: var(--fs-200); line-height: var(--lh-200); color: var(--faint); }
  .keys span { display: inline-flex; align-items: center; gap: 6px; white-space: nowrap; }
  .sw { width: 9px; height: 9px; border-radius: 2px; display: inline-block;
    border: 1px solid rgba(0,0,0,.35); }
  .sw.inh { background: var(--hair2); }
  .sw.ovr { background: var(--ovr); }
  .sw.mod { background: var(--warn); }
  .toast { color: var(--muted); font-size: var(--fs-200); line-height: var(--lh-200); }

  /* ---------- panes ---------- */
  .layout { display: grid;
    grid-template-columns: var(--left, 190px) 5px minmax(280px, 1fr) 5px var(--right, 440px);
    grid-template-rows: minmax(0, 1fr);
    flex: 1; min-height: 0; }
  .gutter { cursor: col-resize; background: transparent; position: relative; }
  .gutter::after { content: ''; position: absolute; left: 2px; top: 0; bottom: 0;
    width: 1px; background: var(--hair); }
  .gutter:hover::after, .gutter.drag::after { background: var(--brand); width: 2px; }

  nav.steps { background: var(--surface); border-right: 1px solid var(--hair);
    padding: 8px 0; overflow: auto; }
  .steptab { display: flex; align-items: center; gap: 10px; padding: 7px 12px 7px 14px;
    cursor: pointer; border-left: 2px solid transparent;
    font-size: var(--fs-300); line-height: var(--lh-300); color: var(--muted); }
  .steptab:hover { background: var(--sunken); color: var(--ink); }
  .steptab.on { background: var(--brand-soft); border-left-color: var(--brand);
    color: var(--ink); font-weight: var(--fw-semi); }
  .steptab .idx { font-size: var(--fs-200); color: var(--faint);
    flex: none; width: 14px; font-variant-numeric: tabular-nums; }
  .steptab.on .idx { color: var(--brand); }
  .steptab .nm { flex: 1; display: -webkit-box; -webkit-line-clamp: 2; line-clamp: 2;
    -webkit-box-orient: vertical; overflow: hidden; }
  .badge { font-size: var(--fs-200); line-height: var(--lh-200); color: var(--err); flex: none;
    font-variant-numeric: tabular-nums; }
  .badge.err::before { content: '\25CF'; font-size: 7px; vertical-align: middle; margin-right: 4px; }
  .badge.ok { display: none; }

  /* ---------- middle: cards of inputs ---------- */
  main { background: var(--bg); padding: 18px 20px 40px; overflow: auto; }
  .step-h { margin: 0; font-size: var(--fs-500); line-height: var(--lh-500); font-weight: var(--fw-semi); }
  .step-sub { color: var(--faint); font-size: var(--fs-200); line-height: var(--lh-200); margin: 3px 0 14px; }
  code.inl, .step-sub code { font-family: var(--mono); font-size: var(--fs-200); color: var(--muted); }
  .card { background: var(--surface); border: 1px solid var(--hair); border-radius: var(--r);
    margin-bottom: 14px; overflow: hidden; }
  .card__h { padding: 12px 16px 11px; border-bottom: 1px solid var(--hair); }
  .sec-h { margin: 0; font-size: var(--fs-400); line-height: var(--lh-400);
    font-weight: var(--fw-semi); color: var(--ink); }
  .sec-sub { margin: 2px 0 0; font-size: var(--fs-200); line-height: var(--lh-200); color: var(--muted); }
  .note-row { margin: 0; padding: 12px 16px; font-size: var(--fs-300); line-height: var(--lh-300);
    color: var(--muted); border-bottom: 1px solid var(--hair); }

  .irow { padding: 12px 16px; border-bottom: 1px solid var(--hair);
    border-left: 2px solid transparent; }
  .irow:last-child { border-bottom: 0; }
  .irow.dirty { border-left-color: var(--warn); background: #fffdf6; }
  .irow__top { display: flex; align-items: baseline; gap: 8px; flex-wrap: wrap; }
  .irow__nm { font-size: var(--fs-300); line-height: var(--lh-300); font-weight: var(--fw-semi);
    display: inline-flex; align-items: baseline; gap: 6px; }
  .req { color: var(--err); }
  .lock { color: var(--faint); font-size: var(--fs-200); }
  .ovr-chip { margin-left: auto; font-size: var(--fs-200); line-height: var(--lh-200);
    color: var(--ovr); white-space: nowrap; }
  .ovr-chip.none { color: var(--faint); }
  .mod-chip { font-size: var(--fs-200); line-height: var(--lh-200); color: var(--warn);
    font-weight: var(--fw-reg); }
  .irow__desc { color: var(--muted); font-size: var(--fs-200); line-height: var(--lh-200);
    margin-top: 6px; max-width: 78ch;
    display: -webkit-box; -webkit-line-clamp: 2; line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }

  input[type=text], input[type=search], select, textarea {
    width: 100%; max-width: 520px; margin-top: 6px; padding: 5px 9px;
    font-family: var(--sans); font-size: var(--fs-300); line-height: var(--lh-300); color: var(--ink);
    background: var(--surface); border: 1px solid var(--field-border); border-radius: 4px; }
  input[type=text]:hover, input[type=search]:hover, select:hover, textarea:hover { border-color: var(--ink); }
  input[type=text]:focus, input[type=search]:focus, select:focus, textarea:focus {
    outline: 2px solid var(--brand); outline-offset: 0; border-color: var(--brand); }
  /* Custom chevron: the native one is painted over the text box, not beside it. */
  select { appearance: none; -webkit-appearance: none; padding-right: 30px;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 12 12'><path fill='%235a5a58' d='M2.2 4.3a.7.7 0 0 1 1 0L6 7.1l2.8-2.8a.7.7 0 1 1 1 1L6.5 8.6a.7.7 0 0 1-1 0L2.2 5.3a.7.7 0 0 1 0-1Z'/></svg>");
    background-repeat: no-repeat; background-position: right 10px center; background-size: 11px; }
  ::placeholder { color: var(--muted); opacity: 1; }
  input:disabled, select:disabled, textarea:disabled {
    color: var(--faint); background: #f0f0ee; border-color: var(--hair2); }
  textarea { min-height: 64px; font-family: var(--mono); font-size: var(--fs-200); line-height: var(--lh-200); }
  .bad { background: #fdf4f4 !important; border-color: var(--err) !important; }
  .err { color: var(--err); font-size: var(--fs-200); line-height: var(--lh-200); margin-top: 4px; }
  .row-acts { display: flex; gap: 14px; margin-top: 7px; flex-wrap: wrap; }
  .lnk { font: inherit; font-size: var(--fs-200); line-height: var(--lh-200);
    background: none; border: 0; padding: 0; color: var(--brand); cursor: pointer;
    text-decoration: underline; }
  .lnk:hover { color: var(--brand-ink); }
  .lnk[disabled] { color: var(--faint); cursor: default; text-decoration: none; }

  .search { position: relative; display: flex; align-items: center; flex: 0 1 320px; min-width: 190px; }
  .search__icon { position: absolute; left: 9px; width: 14px; height: 14px;
    color: var(--muted); pointer-events: none; }
  .search input { margin: 0; padding: 5px 30px; font-size: var(--fs-300); max-width: none; }
  .search input::-webkit-search-cancel-button, .search input::-webkit-search-decoration { display: none; }
  .search__clear { position: absolute; right: 3px; border: 0; background: none; cursor: pointer;
    color: var(--muted); font-size: var(--fs-200); line-height: 1; padding: 5px 6px; border-radius: 3px; }
  .search__clear:hover { background: var(--sunken); color: var(--ink); }

  .filterbar { display: flex; align-items: center; gap: 12px; margin: 0 0 12px; flex-wrap: wrap; }
  .filterbar .count { font-size: var(--fs-200); line-height: var(--lh-200); color: var(--muted); }

  details.adv { border-top: 1px solid var(--hair); }
  details.adv > summary { cursor: pointer; font-size: var(--fs-300); line-height: var(--lh-300);
    font-weight: var(--fw-semi); color: var(--ink);
    background: var(--sunken); padding: 10px 16px; list-style: none; user-select: none;
    display: flex; align-items: center; gap: 6px; }
  details.adv > summary:hover { background: #f0f0ee; }
  details.adv > summary::-webkit-details-marker { display: none; }
  details.adv > summary::before { content: '\25B8'; display: inline-block; width: 14px; color: var(--muted); }
  details.adv[open] > summary::before { content: '\25BE'; }
  details.adv[open] > summary { border-bottom: 1px solid var(--hair); }
  .adv-n { font-size: var(--fs-200); font-weight: var(--fw-reg); color: var(--muted);
    font-variant-numeric: tabular-nums; }
  .adv-warn { font-size: var(--fs-200); font-weight: var(--fw-reg); color: var(--err); }
  .sum-act { margin-left: auto; }
  .ent-tools + details.adv, .card__h + details.adv { border-top: 0; }

  /* ---------- structured value editors ---------- */
  .arr-wrap { overflow-x: auto; max-width: 100%; margin-top: 6px;
    border: 1px solid var(--field-border); border-radius: 4px; }
  .arr-wrap:focus-visible { outline: 2px solid var(--brand); outline-offset: 1px; }
  table.arr { border-collapse: collapse; font-size: var(--fs-200); width: 100%; }
  table.arr th { padding: 6px 10px; text-align: left; white-space: nowrap;
    font-size: var(--fs-200); line-height: var(--lh-200); font-weight: var(--fw-semi);
    color: var(--muted); background: var(--sunken); border-bottom: 1px solid var(--hair2); }
  table.arr td { padding: 0; border-bottom: 1px solid var(--hair); vertical-align: middle; }
  table.arr tbody tr:last-child td { border-bottom: 0; }
  table.arr tbody tr:hover td { background: var(--sunken); }
  table.arr input[type=text], table.arr select { margin: 0; min-width: 118px; max-width: none;
    background-color: transparent; border-color: transparent; border-radius: 0;
    padding: 6px 10px; font-size: var(--fs-200); line-height: var(--lh-200); }
  table.arr select { width: auto; padding-right: 26px; background-position: right 7px center; }
  table.arr input[type=text]:focus, table.arr select:focus { background-color: var(--surface); }
  table.arr input:disabled, table.arr select:disabled { background-color: transparent; }
  table.arr .empty { color: var(--muted); padding: 10px; }
  table.arr td:last-child { padding: 0 10px; text-align: right; }
  .arr-acts { margin-top: 6px; display: flex; gap: 14px; }
  .kv { display: flex; flex-direction: column; gap: 5px; max-width: 520px; margin-top: 6px; }
  .kv-row { display: flex; gap: 6px; align-items: center; }
  .kv-row input { flex: 1; min-width: 0; margin-top: 0; }
  .cplx.bad { outline: 1px solid var(--err); border-radius: 4px; }

  /* ---------- right: overrides + json ---------- */
  aside { background: var(--bg); border-left: 1px solid var(--hair);
    display: flex; flex-direction: column; min-height: 0; }
  .aside-h { margin: 0 0 12px; font-size: var(--fs-400); line-height: var(--lh-400);
    font-weight: var(--fw-semi); }
  .ov-pane { flex: 1; min-height: 0; overflow: auto; padding: 16px; }
  .ent-tools { display: flex; flex-direction: column; gap: 3px;
    padding: 10px 14px; border-bottom: 1px solid var(--hair); }
  .ent-lbl { font-size: var(--fs-200); line-height: var(--lh-200); color: var(--muted); }
  .ent-row { display: flex; align-items: stretch; gap: 6px; }
  .ent-row .btn { display: inline-flex; align-items: center; white-space: nowrap; }
  .ent-tools select { flex: 1; min-width: 0; max-width: none; margin-top: 0;
    text-overflow: ellipsis; }
  .frow { padding: 11px 14px; border-bottom: 1px solid var(--hair);
    border-left: 2px solid transparent; }
  .frow:last-child { border-bottom: 0; }
  .frow[data-ovr="1"] { border-left-color: var(--ovr); }
  .frow[data-ovr="1"] > input[type=text], .frow[data-ovr="1"] > select { color: var(--ovr); }
  .frow.dirty { border-left-color: var(--warn); background: #fffdf6; }
  .frow__nm { font-size: var(--fs-300); line-height: var(--lh-300); font-weight: var(--fw-semi);
    display: flex; align-items: baseline; gap: 6px; flex-wrap: wrap; }
  .tag { font-size: var(--fs-200); font-weight: var(--fw-reg); color: var(--ovr); }
  .inh { color: var(--faint); font-size: var(--fs-200); line-height: var(--lh-200); margin-top: 5px; }
  .ov-empty { color: var(--muted); font-size: var(--fs-300); padding: 12px 14px; }
  pre { margin: 0; padding: 12px 14px; background: var(--surface);
    border: 1px solid var(--hair); border-radius: var(--r); color: var(--ink);
    overflow: auto; font-family: var(--mono); font-size: var(--fs-200); line-height: var(--lh-200);
    white-space: pre-wrap; word-break: break-word; max-height: 34vh; margin-bottom: 16px; }

  /* ---------- overlays ---------- */
  .pop-scrim { position: fixed; inset: 0; background: rgba(0,0,0,.28); display: none; z-index: 60; }
  .pop-scrim.open { display: block; }
  .pop { position: fixed; z-index: 61; top: 50%; left: 50%; transform: translate(-50%,-50%);
    width: 600px; max-width: 92vw; max-height: 88vh; overflow: auto;
    background: var(--surface); border-radius: 8px;
    box-shadow: 0 16px 48px rgba(0,0,0,.22); padding: 22px 24px; display: none; }
  .pop.open { display: block; }
  .pop--wide { width: 860px; }
  .pop__h2 { font-size: var(--fs-400); line-height: var(--lh-400); font-weight: var(--fw-semi);
    margin: 4px 0 6px; }
  .pop__ok { margin: 0 0 12px; padding: 9px 12px; border-radius: 4px;
    background: #f1f8f1; border: 1px solid #cfe4cf; color: var(--ok);
    font-size: var(--fs-200); line-height: var(--lh-200); }
  .pop__h { font-size: var(--fs-500); line-height: var(--lh-500); font-weight: var(--fw-semi);
    margin-bottom: 6px; }
  .pop__p { color: var(--muted); font-size: var(--fs-300); line-height: var(--lh-300); margin: 0 0 12px; }
  .pop__warn { margin: 0 0 12px; padding: 9px 12px; border-radius: 4px;
    background: #fdf4f4; border: 1px solid #f0cfcf; color: var(--err);
    font-size: var(--fs-200); line-height: var(--lh-200); }
  .toggle { display: inline-flex; align-items: center; gap: 8px;
    font-size: var(--fs-300); margin-bottom: 10px; }
  .toggle input { width: auto; margin: 0; }
  .cmd { background: var(--sunken); border: 1px solid var(--hair); color: var(--ink);
    border-radius: 4px; padding: 10px 12px; font-family: var(--mono);
    font-size: var(--fs-200); line-height: var(--lh-200);
    word-break: break-all; margin-bottom: 12px; }
  .issues { max-height: 46vh; overflow: auto; margin-bottom: 14px;
    border: 1px solid var(--hair); border-radius: var(--r); }
  .issue { display: block; width: 100%; text-align: left; font: inherit;
    font-size: var(--fs-300); line-height: var(--lh-300);
    background: none; border: 0; border-bottom: 1px solid var(--hair); padding: 9px 12px;
    cursor: pointer; color: var(--ink); }
  .issue:last-child { border-bottom: 0; }
  .issue:hover { background: var(--sunken); }
  .issue .where { color: var(--muted); font-size: var(--fs-200); line-height: var(--lh-200); margin-top: 2px; }

  .flash { animation: flash 1.5s ease-out; }
  @keyframes flash { from { background: #fff4ce; } to { background: transparent; } }
  .steptab:focus-visible, .lnk:focus-visible, .gutter:focus-visible, .issue:focus-visible,
  .vsummary:focus-visible, summary:focus-visible, .btn:focus-visible,
  pre:focus-visible, main:focus-visible, .ov-pane:focus-visible {
    outline: 2px solid var(--brand); outline-offset: -2px; }

  /* ---------- responsive: 3 cols -> 2 -> stacked ---------- */
  @media (max-width: 1440px) { .layout { --right: 390px; } }
  @media (max-width: 1240px) { .layout { --left: 168px; --right: 350px; } }
  @media (max-width: 1080px) {
    /* aside drops under the step + form columns and keeps its own scroll */
    .layout { grid-template-columns: var(--left, 168px) 5px minmax(0, 1fr);
      grid-template-rows: minmax(240px, 1fr) minmax(260px, 42vh); }
    #gutterR { display: none; }
    aside { grid-column: 1 / -1; grid-row: 2; border-left: 0; border-top: 1px solid var(--hair); }
  }
  @media (max-width: 860px) {
    html { height: auto; overflow: visible; }
    body { height: auto; min-height: 0; overflow: visible; }
    .layout { display: flex; flex-direction: column; }
    .gutter { display: none; }
    nav.steps { border-right: 0; border-bottom: 1px solid var(--hair);
      display: flex; overflow-x: auto; padding: 4px; flex: none; }
    .steptab { border-left: 0; border-bottom: 2px solid transparent; white-space: nowrap;
