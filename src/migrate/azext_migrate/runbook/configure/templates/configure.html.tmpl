  if (rule.allowedValues) return `<select data-prop="${esc(key)}" ${dis}><option value="">--</option>` +
    rule.allowedValues.map(o => `<option value="${esc(o)}" ${String(o) === String(v) ? 'selected' : ''}>${esc(o)}</option>`).join('') + `</select>`;
  if (rule.type === 'boolean') { const s = x => String(v) === x ? 'selected' : '';
    return `<select data-prop="${esc(key)}" ${dis}><option value="">--</option>
      <option value="true" ${s('true')}>true</option><option value="false" ${s('false')}>false</option></select>`; }
  return `<input type="text" data-prop="${esc(key)}" value="${esc(v)}" ${dis} />`;
}
function kvCtrl(path, obj, editable) {
  const d = editable ? '' : 'disabled';
  const rows = Object.keys(obj).map(k => `<div class="kv-row">
      <input type="text" data-kv="k" value="${esc(k)}" placeholder="key" ${d} />
      <input type="text" data-kv="v" value="${esc(obj[k])}" placeholder="value" ${d} />
      <button type="button" class="lnk" data-kv-del="1" ${d}>Remove</button></div>`).join('');
  return `<div class="cplx" data-path="${esc(path)}" data-cplx="${esc(path)}" data-kind="kv">
    <div class="kv">${rows || '<div class="inh">No entries</div>'}</div>
    <div class="arr-acts"><button type="button" class="lnk" data-kv-add="1" ${d}>+ Add entry</button></div>
  </div>`;
}
function collectComplex(box) {
  const rule = ruleForPath(box.dataset.cplx);
  if (box.dataset.kind === 'grid') {
    const props = itemProps(rule), keys = Object.keys(props);
    return [...box.querySelectorAll('tbody tr[data-idx]')].map(tr => {
      const o = {};
      keys.forEach(k => { const el = tr.querySelector(`[data-prop="${k}"]`); o[k] = el ? coerce(el.value, props[k]) : null; });
      return o;
    });
  }
  if (box.dataset.kind === 'kv') {
    const o = {};
    box.querySelectorAll('.kv-row').forEach(r => {
      const k = r.querySelector('[data-kv="k"]').value.trim();
      if (k) o[k] = r.querySelector('[data-kv="v"]').value;
    });
    return o;
  }
  return coerce(box.querySelector('textarea').value, rule);
}

// ---- middle: step inputs --------------------------------------------------
function inputRow(sid, kind, f, r, data) {
  const path = `${kind}|${sid}|${f}`;
  const locked = r.isEditable === false, dis = locked ? 'disabled' : '';
  const n = entitiesFor(sid).length, c = kind === 'D' ? overrideCount(sid, f) : 0;
  const chip = kind === 'D'
    ? `<span class="ovr-chip" data-chip="${esc(f)}" ${c ? '' : 'hidden'}>${c ? esc(overrideLabel(c, n)) : ''}</span>` : '';
  return `<div class="irow" data-row="${esc(path)}">
    <div class="irow__top">
      <span class="irow__nm">${esc(f)}${r.required ? '<span class="req" title="Required">*</span>' : ''}
        ${locked ? '<span class="lock" title="Not editable (isEditable: false in the schema)">&#128274;</span>' : ''}
        <span class="mod-chip" hidden>modified</span></span>${chip}
    </div>
    ${isComplex(r) ? complexCtrl(path, r, data[f], !locked) : scalarCtrl(path, r, data[f], dis)}
    ${r.description ? `<div class="irow__desc" title="${esc(r.description)}">${esc(r.description)}</div>` : ''}
    <div class="err" data-err="${esc(path)}"></div></div>`;
}
// Required and optional get the same section treatment; required stays open.
function renderGroup(title, sub, sid, kind, fields, rules, data) {
  if (!fields.length) return '';
  const req = fields.filter(f => rules[f].required), opt = fields.filter(f => !rules[f].required);
  // Empty because the schema says so, or because the search hid them?
  const all = kind === 'A' ? applianceFields(sid) : entityFields(sid);
  const noneRequired = !all.some(f => rules[f].required);
  const noneOptional = !all.some(f => !rules[f].required);
  const note = (schemaEmpty, word) => `<p class="note-row">${schemaEmpty
    ? `No ${word} inputs for this step.` : `No ${word} inputs match your search.`}</p>`;
  return `<section class="card">
    <div class="card__h"><h3 class="sec-h">${title}</h3><p class="sec-sub">${sub}</p></div>
    <details class="adv" data-sec="req" open>
      <summary>Required inputs <span class="adv-n">${req.length}</span></summary>
      ${req.length ? req.map(f => inputRow(sid, kind, f, rules[f], data)).join('')
                   : note(noneRequired, 'required')}
    </details>
    <details class="adv" data-sec="opt" ${fieldFilter ? 'open' : ''}>
      <summary>Optional inputs <span class="adv-n">${opt.length}</span></summary>
      ${opt.length ? opt.map(f => inputRow(sid, kind, f, rules[f], data)).join('')
                   : note(noneOptional, 'optional')}
    </details>
  </section>`;
}
function renderForm() {
  const sid = current, rules = rulesFor(sid), data = DOC.stepInputs[sid];
  const host = document.getElementById('form');
  const es = entitiesFor(sid), all = stepFields(sid);
  let html = `<h2 class="step-h">${esc(stepLabel(sid))}</h2>
    <p class="step-sub">Step id <code>${esc(sid)}</code> &middot; ${
      es.length ? `${es.length} ${es.length === 1 ? 'workload' : 'workloads'}` : 'no per-workload inputs'}</p>`;
  if (!all.length) {
    host.innerHTML = html + `<p class="step-sub">This step has no configurable inputs.</p>`;
    renderOverrides(); refreshValidation(); return;
  }
  const app = applianceFields(sid).filter(f => matchField(rules, f));
  const ent = entityFields(sid).filter(f => matchField(rules, f));
  html += `<div class="filterbar">
    ${searchBox('fldFilter', fieldFilter, 'Search inputs by name or description', 'Search inputs')}
    <span class="count" id="fldCount" role="status">${app.length + ent.length} of ${all.length} inputs shown</span>
  </div>`;
  html += renderGroup('Step inputs', 'One value for the whole step. Cannot be overridden per workload.', sid, 'A', app, rules, data);
  html += renderGroup('Step inputs', 'Used for every workload unless you override for a workload on the right.',
    sid, 'D', ent, rules, data);
  if (!app.length && !ent.length) html += `<p class="step-sub">No inputs match &ldquo;${esc(fieldFilter)}&rdquo;.</p>`;
  host.innerHTML = html;

  bindSearch('fldFilter', v => { fieldFilter = v; renderForm(); });
  bindInputs('#form');
  renderOverrides();
  refreshValidation();
}

// ---- right-top: per-WORKLOAD overrides (pick a workload, edit its inputs) --
function overrideRow(sid, eid, f, r, data, sect) {
  const path = `O|${sid}|${eid}|${f}`;
  const ov = hasOverride(sid, eid, f), locked = r.isEditable === false;
  // Complex editors have no "blank" state, so entering/leaving the override is
  // an explicit action; scalars keep the blank-means-inherit control.
  // Complex fields show the editable table directly (seeded from the inherited
  // step value); adding or editing a row creates the override for this workload.
  const ctrl = isComplex(r)
    ? complexCtrl(path, r, effective(sid, eid, f), !locked)
    : overrideCtrl(path, r, ov ? woFor(sid, eid)[f] : null, data[f], ov, locked ? 'disabled' : '');
  const acts = locked ? '' :
    `<button type="button" class="lnk" data-revert="${esc(f)}" ${ov ? '' : 'hidden'}
       title="Remove this workload's override so it uses the step input">Remove override</button>`;
  return `<div class="frow" data-fld="${esc(f)}" data-row="${esc(path)}" data-ovr="${ov ? 1 : 0}" data-sect="${sect}">
    <div class="frow__nm">${esc(f)}${r.required ? '<span class="req" title="Required">*</span>' : ''}
      ${locked ? '<span class="lock" title="Not editable (isEditable: false in the schema)">&#128274;</span>' : ''}
      <span class="tag" ${ov ? '' : 'hidden'}>override</span>
      <span class="mod-chip" hidden>modified</span></div>
    ${ctrl}
    <div class="inh" data-inh="${esc(sid)}|${esc(eid)}|${esc(f)}"></div>
    <div class="row-acts" ${acts ? '' : 'hidden'}>${acts}</div>
    <div class="err" data-err="${esc(path)}"></div>
  </div>`;
}
function renderOverrides() {
  const pane = document.getElementById('ovPane');
  const sid = current, rules = rulesFor(sid), data = DOC.stepInputs[sid];
  const head = '<h2 class="aside-h" id="asideH">Workload level overrides</h2>';
  const fields = entityFields(sid);
  if (!fields.length) { pane.innerHTML = head + `<section class="card"><div class="ov-empty">This step has no per-workload inputs.</div></section>`; return; }
  const es = entitiesFor(sid);
  if (!es.length) { pane.innerHTML = head + `<section class="card"><div class="ov-empty">This step has no workloads.</div></section>`; return; }
  const cur = es.find(e => e.id === selEntity) || es[0];
  selEntity = cur.id;
  const vis = fields.filter(f => matchField(rules, f));
  const ovCount = entityOverrideCount(sid, cur.id);
  const ovF = vis.filter(f => hasOverride(sid, cur.id, f));
  const inhF = vis.filter(f => !hasOverride(sid, cur.id, f));
  // An inherited value can still be invalid for this workload, so surface that
  // on the collapsed section rather than hiding it.
  const inhBad = inhF.filter(f => fieldError(rules[f], effective(sid, cur.id, f))).length;
  const sections = !vis.length
    ? `<div class="ov-empty">No inputs match &ldquo;${esc(fieldFilter)}&rdquo;.</div>`
    : `<details class="adv" data-sec="ov" open>
        <summary>Overrides <span class="adv-n">${ovF.length}</span>${
          ovCount ? `<button type="button" class="lnk sum-act" id="entClear">Remove all overrides</button>` : ''}</summary>
        ${ovF.length ? ovF.map(f => overrideRow(sid, cur.id, f, rules[f], data, 'ov')).join('')
                     : `<p class="note-row">No overrides added &mdash; this workload uses every step input.</p>`}
      </details>
      <details class="adv" data-sec="inh" ${fieldFilter || inhBad ? 'open' : ''}>
        <summary>Inherited from step <span class="adv-n">${inhF.length}</span>${
          inhBad ? `<span class="adv-warn">${inhBad} need${inhBad === 1 ? 's' : ''} attention</span>` : ''}</summary>
        ${inhF.map(f => overrideRow(sid, cur.id, f, rules[f], data, 'inh')).join('')}
      </details>`;

  pane.innerHTML = head + `<section class="card">
    <div class="ent-tools">
      <label class="ent-lbl" for="entSel">Workload</label>
      <div class="ent-row">
        <select id="entSel">${es.map(e => {
          const er = entityErrors(sid, e.id);
          const tail = er ? ` \u2022 ${er} need${er === 1 ? 's' : ''} attention` : '';
          return `<option value="${esc(e.id)}" ${e.id === cur.id ? 'selected' : ''}>${esc(e.name + tail)}</option>`;
        }).join('')}</select>
      </div>
    </div>
    ${sections}
  </section>`;

  bindInputs('#ovPane');
  document.getElementById('entSel').addEventListener('change', e => { selEntity = e.target.value; renderOverrides(); });
  const clearBtn = document.getElementById('entClear');
  if (clearBtn) clearBtn.addEventListener('click', e => {
    e.preventDefault(); e.stopPropagation(); // keep the disclosure from toggling
    // Remove the workload's entire override entry (and the map if now empty).
    const wo = DOC.stepInputs[sid].workloadOverrides;
    if (wo) { delete wo[cur.id]; if (!Object.keys(wo).length) delete DOC.stepInputs[sid].workloadOverrides; }
    renderForm(); toast(`Removed all overrides for ${cur.name}.`);
  });
  pane.querySelectorAll('[data-revert]').forEach(b => b.addEventListener('click', () => {
    const f = b.dataset.revert;
    accessor(`O|${sid}|${cur.id}|${f}`).clear();
    renderForm(); toast(`Removed the ${f} override for ${cur.name}.`);
  }));
  refreshValidation();
}

// Re-render a pane but keep which collapsible sections are open and the scroll
// position, so a structural edit (add/remove row/entry) doesn't collapse the
// section the user is working in.
function reRenderPreserving(fn, sel) {
  const host = document.querySelector(sel);
  const open = new Set([...host.querySelectorAll('details.adv[open]')].map(d => d.dataset.sec));
  const scroll = host.scrollTop;
  fn();
  const after = document.querySelector(sel);
  after.querySelectorAll('details.adv').forEach(d => { d.open = open.has(d.dataset.sec); });
  after.scrollTop = scroll;
}

// Simple controls write straight through; complex editors re-serialise their
// whole value, and structural edits (add/remove row) re-render the pane.
function bindInputs(scope) {
  const root = document.querySelector(scope);
  if (!root) return;
  root.querySelectorAll('[data-path]').forEach(el => {
    if (el.closest('.cplx')) return;
    el.addEventListener(el.tagName === 'SELECT' ? 'change' : 'input', () => setValue(el.dataset.path, el.value));
    // Re-section the row once the edit is committed, never mid-keystroke.
    el.addEventListener('change', () => {
      const row = el.closest('.frow'); if (!row) return;
      const p = row.dataset.row.split('|');
      if (row.dataset.sect !== (hasOverride(p[1], p[2], p[3]) ? 'ov' : 'inh')) renderOverrides();
    });
  });
  root.querySelectorAll('.cplx').forEach(box => {
    const path = box.dataset.cplx;
    const push = () => { accessor(path).set(collectComplex(box)); afterEdit(path); };
    box.addEventListener('input', e => { if (e.target.matches('input, textarea')) push(); });
    box.addEventListener('change', e => { if (e.target.matches('select')) push(); });
    box.addEventListener('click', e => {
      const t = e.target;
      if (!t.matches('[data-arr-add], [data-arr-del], [data-kv-add], [data-kv-del]')) return;
      e.preventDefault();
      const acc = accessor(path), val = collectComplex(box);
      if (t.dataset.arrAdd) val.push({});
      else if (t.dataset.arrDel !== undefined) val.splice(+t.dataset.arrDel, 1);
      else if (t.dataset.kvAdd) { let i = 1; while (has(val, 'key' + i)) i++; val['key' + i] = ''; }
      else delete val[t.closest('.kv-row').querySelector('[data-kv="k"]').value.trim()];
      acc.set(val);
      // Keep the open sections + scroll so add/remove row doesn't collapse the
      // section the user is working in.
      const ov = path.startsWith('O|');
      reRenderPreserving(ov ? renderOverrides : renderForm, ov ? '#ovPane' : '#form');
    });
  });
}

// ---- edit + validate ------------------------------------------------------
function coerce(raw, rule) {
  if (raw === '' || raw === '__inh__') return null;
  if (rule.type === 'boolean') return raw === 'true';
  if (rule.type === 'integer') { const n = parseInt(raw, 10); return Number.isNaN(n) ? raw : n; }
  if (isComplex(rule)) { try { return JSON.parse(raw); } catch (e) { return raw; } }
  return raw;
}
function ensureWo(sid, eid) {
  const s = DOC.stepInputs[sid];
  if (!s.workloadOverrides) s.workloadOverrides = {};
  if (!s.workloadOverrides[eid]) s.workloadOverrides[eid] = {};
  return s.workloadOverrides[eid];
}
function setValue(path, raw) {
  const acc = accessor(path);
  if (acc.kind === 'O' && (raw === '' || raw === '__inh__')) acc.clear();
  else acc.set(coerce(raw, ruleForPath(path)));
  afterEdit(path);
}
// Refresh derived UI in place so typing never loses focus.
function afterEdit(path) {
  const p = path.split('|');
  updateChips(p[1]);
  refreshValidation();
  renderTabs();
}
function updateChips(sid) {
  const n = entitiesFor(sid).length;
  document.querySelectorAll('#form [data-chip]').forEach(el => {
    const c = overrideCount(sid, el.dataset.chip);
    el.textContent = c ? overrideLabel(c, n) : '';
    el.hidden = !c;
  });
}
function updateRowState() {
  document.querySelectorAll('[data-row]').forEach(row => {
    const p = row.dataset.row.split('|');
    const isOvr = p[0] === 'O';
    const dirty = isOvr ? dirtyOverride(p[1], p[2], p[3]) : dirtyTop(p[1], p[2]);
    row.classList.toggle('dirty', dirty);
    const chip = row.querySelector('.mod-chip'); if (chip) chip.hidden = !dirty;
    if (!isOvr) return;
    const ov = hasOverride(p[1], p[2], p[3]), locked = rulesFor(p[1])[p[3]].isEditable === false;
    row.dataset.ovr = ov ? 1 : 0;
    const tag = row.querySelector('.tag'); if (tag) tag.hidden = !ov;
    const acts = row.querySelector('.row-acts');
    if (!acts) return;
    acts.querySelectorAll('[data-revert]').forEach(b => b.hidden = !ov || locked);
    acts.hidden = ![...acts.children].some(c => !c.hidden);
  });
}
function ctrlEl(path) { return document.querySelector(`[data-path="${path}"]`); }
function mark(path, err) {
  const el = ctrlEl(path); if (el) el.classList.toggle('bad', !!err);
  const e = document.querySelector(`[data-err="${path}"]`); if (e) e.textContent = err || '';
}
function refreshValidation() {
  const sid = current, rules = rulesFor(sid), data = DOC.stepInputs[sid];
  applianceFields(sid).forEach(f => mark(`A|${sid}|${f}`, fieldError(rules[f], data[f])));
  entityFields(sid).forEach(f => {
    const r = rules[f];
    const inheritingBad = entitiesFor(sid).some(e => !hasOverride(sid, e.id, f)) && !!fieldError(r, data[f]);
    mark(`D|${sid}|${f}`, inheritingBad ? fieldError(r, data[f]) : null);
    // right pane shows the selected entity's inputs
    const ov = hasOverride(sid, selEntity, f), err = fieldError(r, effective(sid, selEntity, f));
    mark(`O|${sid}|${selEntity}|${f}`, ov ? err : null);
    const inh = document.querySelector(`[data-inh="${sid}|${selEntity}|${f}"]`);
    if (inh) {
      // The value itself is already on the control; this line is only for errors.
      inh.textContent = ov ? '' : (err || '');
      inh.style.color = 'var(--err)';
    }
  });
  updateRowState();
  sync();
}
function sync() {
  const m = META;
  document.getElementById('json').textContent = JSON.stringify({ stepInputs: DOC.stepInputs }, null, 2);
  const base = m.inputsPath || '';
  const baseName = base ? base.split(/[\\/]/).pop() : PARAM_FILE;
  // Reflect where the file was actually saved. Browsers never expose a file's
  // folder, so Path A can only use the full path when the picked name matches
  // the CLI baseline; Path B assumes the Downloads folder.
  let filePath = base ? `"${base}"` : `./${PARAM_FILE}`;
  let hint = '';
  if (saved && saved.mode === 'A') {
    if (base && saved.name === baseName) { filePath = `"${base}"`; }
    else { filePath = `"${saved.name}"`; hint = 'Your browser doesn\u2019t reveal the folder \u2014 use the full path to where you saved it.'; }
  } else if (saved && saved.mode === 'B') {
    if (m.downloadsPath) { const dl = m.downloadsPath, dlBase = dl.split(/[\\/]/).pop(); filePath = `"${dl.slice(0, dl.length - dlBase.length) + saved.name}"`; }
    else { filePath = `"${saved.name}"`; }
    hint = 'Assumes your Downloads folder \u2014 if the browser saved a numbered copy, update the file name.';
  }
  document.getElementById('cmd').textContent =
    `az migrate runbook parameter upload -g ${m.resourceGroup} -p ${m.project} -n ${m.runbook} --file ${filePath}`;
  const hintEl = document.getElementById('cmdHint');
  if (hintEl) hintEl.textContent = hint;
  const pending = Object.keys(DOC.stepInputs).filter(s => stepErrors(s) > 0).length;
  const vs = document.getElementById('vsummary');
  if (pending > 0) {
    vs.className = 'vsummary bad2';
    vs.innerHTML = `\u26A0 ${pending} step${pending === 1 ? '' : 's'} still ` +
      `need${pending === 1 ? 's' : ''} inputs <span class="vsummary__act">Review</span>`;
    vs.setAttribute('role', 'button');
    vs.tabIndex = 0;
    vs.title = 'Show every input that is still missing or invalid';
  } else {
    vs.className = 'vsummary good';
    vs.textContent = '\u2713 All required inputs set';
    vs.removeAttribute('role');
    vs.removeAttribute('tabindex');
    vs.removeAttribute('title');
  }
  document.getElementById('resetBtn').disabled = !hasEdits();
}
function renderAll() { renderTabs(); renderForm(); }

// ---- outstanding inputs, across every step --------------------------------
function allIssues() {
  const out = [];
  Object.keys(DOC.stepInputs).forEach(sid => {
    const rules = rulesFor(sid), data = DOC.stepInputs[sid];
    applianceFields(sid).forEach(f => {
      const msg = fieldError(rules[f], data[f]);
      if (msg) out.push({ sid, f, eid: null, name: null, msg });
    });
    entityFields(sid).forEach(f => entitiesFor(sid).forEach(e => {
      const msg = fieldError(rules[f], effective(sid, e.id, f));
      if (msg) out.push({ sid, f, eid: e.id, name: e.name, msg });
    }));
  });
  return out;
}
function showIssues() {
  const list = allIssues();
  document.getElementById('issueCount').textContent = list.length
    ? `${list.length} input(s) are missing or invalid. Select one to jump to it.`
    : 'Every input required by the schema is set.';
  document.getElementById('issueList').innerHTML = list.map((it, i) =>
    `<button type="button" class="issue" data-i="${i}">
      <b>${esc(it.f)}</b> &mdash; ${esc(it.msg)}
      <div class="where">${esc(stepLabel(it.sid))}${it.name ? ' \u203A ' + esc(it.name) : ''}</div>
    </button>`).join('');
  document.querySelectorAll('#issueList .issue').forEach(b => b.addEventListener('click', () => {
    const it = list[+b.dataset.i];
    fieldFilter = '';
    current = it.sid;
    if (it.eid) { selEntity = it.eid; }
    renderAll(); closePop();
    revealField(it.eid ? `O|${it.sid}|${it.eid}|${it.f}` : `A|${it.sid}|${it.f}`, `D|${it.sid}|${it.f}`);
  }));
  openPop('issuePop');
}
function revealField(path, altPath) {
  const alt = document.querySelector(`[data-row="${altPath}"]`);
  if (alt) { const d = alt.closest('details.adv'); if (d) d.open = true; }
  const row = document.querySelector(`[data-row="${path}"]`) || alt;
  if (!row) return;
  const det = row.closest('details.adv'); if (det) det.open = true;
  row.scrollIntoView({ block: 'center' });
  row.classList.add('flash');
  setTimeout(() => row.classList.remove('flash'), 1500);
}

// ---- toolbar / popover ----------------------------------------------------
function firstFailingStep() { return Object.keys(DOC.stepInputs).find(s => stepErrors(s) > 0); }// Rebuild the full inputs.json (only stepInputs are edited here) and export it
// via a browser download; the file lands in your Downloads folder.
function buildInputsJson() {
  const root = JSON.parse(JSON.stringify(BOOT.inputsRoot || {}));
  if (root.inputs && typeof root.inputs === 'object') { root.inputs.stepInputs = DOC.stepInputs; }
  else { root.stepInputs = DOC.stepInputs; }
  return JSON.stringify(root, null, 2);
}
function downloadInputs(text) {
  try {
    const blob = new Blob([text], { type: 'application/json' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url; a.download = PARAM_FILE;
    document.body.appendChild(a); a.click(); document.body.removeChild(a);
    setTimeout(() => URL.revokeObjectURL(url), 1000);
    return true;
  } catch (e) { return false; }
}
// Real disk save when the browser supports the File System Access API: the
// first Save prompts for a location, later Saves overwrite the same file.
// Otherwise fall back to a Downloads-folder download.
let fileHandle = null;
let saved = null; // {mode:'A'|'B', name} — drives the --file path shown
// Fall back to a download and report the outcome honestly (never a silent no-op
// and never a false "saved"). warnSave=true renders the amber note in showFile.
function saveFallback(text, reason) {
  if (!downloadInputs(text)) {
    toast('\u2715 Save failed \u2014 open \u201cView updated parameters file\u201d and copy the JSON.');
    return;
  }
  saved = { mode: 'B', name: PARAM_FILE };
  savedSnapshot = JSON.stringify(DOC.stepInputs);
  showFile(reason
    ? `${reason} \u2014 downloaded ${PARAM_FILE} to your Downloads folder instead.`
    : `Saved ${PARAM_FILE} to your Downloads folder.`, !!reason);
}
async function saveToDisk() {
  const btn = document.getElementById('saveBtn');
  sync();
  let text;
  try { text = buildInputsJson(); }
  catch (e) { toast('\u2715 Couldn\u2019t build the file \u2014 nothing was saved.'); return; }
  const label = btn.textContent;
  btn.disabled = true; btn.textContent = 'Saving\u2026';
  try {
    if (window.showSaveFilePicker) {
      try {
        if (!fileHandle) {
          fileHandle = await window.showSaveFilePicker({
            suggestedName: PARAM_FILE,
            startIn: 'downloads',
            types: [{ description: 'JSON', accept: { 'application/json': ['.json'] } }]
          });
        }
        const w = await fileHandle.createWritable();
        await w.write(text); await w.close();
        saved = { mode: 'A', name: fileHandle.name };
        savedSnapshot = JSON.stringify(DOC.stepInputs);
        showFile(`Saved to ${fileHandle.name}.`);
      } catch (e) {
        if (e && e.name === 'AbortError') { toast('Save cancelled \u2014 no file written.'); return; }
        fileHandle = null; // chosen location unusable; re-prompt next time
        saveFallback(text, 'Couldn\u2019t write to the location you chose');
      }
      return;
    }
    saveFallback(text, null);
  } finally {
    btn.disabled = false; btn.textContent = label;
  }
}
const FOCUSABLE = 'button:not([disabled]), [href], input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])';
let lastFocus = null;
function openPop(id) {
  lastFocus = document.activeElement;
  document.getElementById('popScrim').classList.add('open');
  const p = document.getElementById(id);
  p.classList.add('open');
  const first = p.querySelector(FOCUSABLE);
  if (first) first.focus();
}
// The page cannot reach the service, so the CLI command lives with the file it
// refers to; opened on demand and again right after a save.
function showFile(savedMsg, warnSave) {
  sync();
  const note = document.getElementById('savedNote');
  note.hidden = !savedMsg;
  note.classList.toggle('pop__ok', !warnSave);
  note.classList.toggle('pop__warn', !!warnSave);
  if (savedMsg) note.textContent = (warnSave ? '\u26A0 ' : '\u2713 ') + savedMsg;
  const list = allIssues();
  const steps = Object.keys(DOC.stepInputs).filter(s => stepErrors(s) > 0).length;
  const warn = document.getElementById('uploadPending');
  warn.hidden = !list.length;
  if (list.length) warn.textContent =
    `\u26A0 ${list.length} input${list.length === 1 ? '' : 's'} across ${steps} step${steps === 1 ? '' : 's'} ` +
    `${list.length === 1 ? 'is' : 'are'} still missing or invalid. Uploading this file sends a partial update.`;
  openPop('jsonPop');
}
function closePop() {
  const wasOpen = document.querySelector('.pop.open');
  document.getElementById('popScrim').classList.remove('open');
  document.querySelectorAll('.pop').forEach(p => p.classList.remove('open'));
  if (wasOpen && lastFocus && lastFocus.focus) lastFocus.focus();
  lastFocus = null;
}
// Keep Tab inside an open dialog.
document.addEventListener('keydown', e => {
  if (e.key !== 'Tab') return;
  const p = document.querySelector('.pop.open'); if (!p) return;
  const f = [...p.querySelectorAll(FOCUSABLE)].filter(el => el.offsetParent !== null);
  if (!f.length) return;
  const first = f[0], last = f[f.length - 1];
  if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
  else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
});
document.getElementById('vsummary').addEventListener('click', () => { if (allIssues().length) showIssues(); });
document.getElementById('vsummary').addEventListener('keydown', e => {
  if ((e.key === 'Enter' || e.key === ' ') && allIssues().length) { e.preventDefault(); showIssues(); }
});
document.getElementById('resetBtn').addEventListener('click', () => {
  if (!hasEdits()) return;
  if (!confirm('Discard all edits and go back to the values you downloaded?\n\n'
    + (isDirty() ? 'Your unsaved changes will be lost. '
                 : 'The file you already saved is not affected. ')
    + 'This cannot be undone.')) return;
  DOC.stepInputs = JSON.parse(JSON.stringify(ORIGINAL));
  savedSnapshot = JSON.stringify(DOC.stepInputs);
  renderAll(); toast('Discarded all edits.');
});
document.getElementById('issueClose').addEventListener('click', closePop);
document.getElementById('popScrim').addEventListener('click', closePop);
document.addEventListener('keydown', e => { if (e.key === 'Escape') closePop(); });
document.getElementById('saveBtn').addEventListener('click', saveToDisk);
// Confirm on the button itself so the feedback is visible even inside a popover
// (a toolbar toast is hidden behind the modal scrim), and only claim success
// when the clipboard write actually resolves.
function copyFeedback(btn, ok) {
  const original = btn.dataset.label || (btn.dataset.label = btn.textContent);
  btn.classList.add(ok ? 'copied' : 'copyfail');
  btn.textContent = ok ? '\u2713 Copied' : '\u2715 Copy failed';
  clearTimeout(btn._copyT);
  btn._copyT = setTimeout(() => {
    btn.classList.remove('copied', 'copyfail');
    btn.textContent = original;
  }, 1400);
}
function copyToClipboard(btn, text) {
  if (navigator.clipboard && navigator.clipboard.writeText) {
    navigator.clipboard.writeText(text).then(() => copyFeedback(btn, true), () => copyFeedback(btn, false));
  } else {
    copyFeedback(btn, false);
  }
}
document.getElementById('copyBtn').addEventListener('click', e =>
  copyToClipboard(e.currentTarget, document.getElementById('cmd').textContent));
// Edits only reach the CLI through a saved file, so guard against losing them.
// hasEdits is measured against the download; isDirty against the last save.
function hasEdits() { return JSON.stringify(DOC.stepInputs) !== JSON.stringify(ORIGINAL); }
function isDirty() { return JSON.stringify(DOC.stepInputs) !== savedSnapshot; }
window.addEventListener('beforeunload', e => { if (isDirty()) { e.preventDefault(); e.returnValue = ''; } });
let toastT;
function toast(msg) { const t = document.getElementById('toast'); t.textContent = msg;
  clearTimeout(toastT); toastT = setTimeout(() => { t.textContent = ''; }, 3200); }

renderMeta();
renderAll();

document.getElementById('jsonBtn').addEventListener('click', () => showFile());
document.getElementById('jsonClose').addEventListener('click', closePop);
document.getElementById('jsonCopy').addEventListener('click', e =>
  copyToClipboard(e.currentTarget, document.getElementById('json').textContent));

// ---- resizable panes (drag the gutters to widen the left/right panes) ------
(function () {
  const layout = document.getElementById('layout');
  function bind(id, varName, edge) {
    const g = document.getElementById(id);
    const clamp = w => {
      const r = layout.getBoundingClientRect();
      return Math.max(140, Math.min(w, r.width - 320));
    };
    g.addEventListener('keydown', e => {
      const step = e.key === 'ArrowLeft' ? -24 : e.key === 'ArrowRight' ? 24 : 0;
      if (!step) return;
      e.preventDefault();
      const cur = parseInt(getComputedStyle(layout).getPropertyValue(varName), 10) ||
        (edge === 'left' ? 180 : 440);
      layout.style.setProperty(varName, clamp(cur + (edge === 'left' ? step : -step)) + 'px');
    });
    g.addEventListener('mousedown', e => {
      e.preventDefault();
      g.classList.add('drag');
      document.body.style.userSelect = 'none';
      const move = ev => {
        const r = layout.getBoundingClientRect();
        const w = edge === 'left' ? ev.clientX - r.left : r.right - ev.clientX;
        layout.style.setProperty(varName, clamp(w) + 'px');
      };
      const up = () => {
        g.classList.remove('drag');
        document.body.style.userSelect = '';
        document.removeEventListener('mousemove', move);
        document.removeEventListener('mouseup', up);
      };
      document.addEventListener('mousemove', move);
      document.addEventListener('mouseup', up);
    });
  }
  bind('gutterL', '--left', 'left');
  bind('gutterR', '--right', 'right');
})();
</script>
</body>
