<body>
<div class="azure-bar">
  <span>&#9729;</span>
  <span class="azure-bar__brand">Azure Migrate</span>
  <span class="pill" id="genAt" hidden></span>
</div>

<header class="topbar">
  <div>
    <div class="eyebrow">Runbook parameters</div>
    <h1 id="title"></h1>
    <div class="crumbs" id="meta"></div>
  </div>
  <div class="acts">
    <span class="toast" id="toast" role="status"></span>
    <button class="btn ghost" id="resetBtn" title="Revert all edits back to the downloaded inputs.json (does not re-download from the service)">Discard changes</button>
    <button class="btn ghost" id="jsonBtn">View updated parameters file</button>
    <button class="btn" id="saveBtn">Save changes</button>
  </div>
</header>

<div class="statusbar">
  <div class="vsummary" id="vsummary"></div>
  <div class="keys" title="Validation follows the schema embedded in this runbook's inputs.json (required, allowed values, type, pattern, editable) — not the live service.">
    <span><i class="sw inh"></i> inherits step input</span>
    <span><i class="sw ovr"></i> workload override</span>
    <span><i class="sw mod"></i> modified</span>
    <span>&#128274; not editable</span>
    <span><b class="req">*</b> required</span>
  </div>
</div>

<div class="layout" id="layout">
  <nav class="steps" id="steps"></nav>
  <div class="gutter" id="gutterL" role="separator" aria-orientation="vertical" tabindex="0"
       title="Drag, or focus and use arrow keys, to resize the steps pane"></div>
  <main id="form" role="tabpanel" tabindex="0"></main>
  <div class="gutter" id="gutterR" role="separator" aria-orientation="vertical" tabindex="0"
       title="Drag, or focus and use arrow keys, to resize the overrides pane"></div>
  <aside>
    <div class="ov-pane" id="ovPane" role="region" aria-labelledby="asideH" tabindex="0"></div>
  </aside>
</div>

<div class="pop-scrim" id="popScrim"></div>
<div class="pop pop--wide" id="jsonPop" role="dialog" aria-modal="true" aria-labelledby="jsonPopH">
  <div class="pop__h" id="jsonPopH">Updated parameters file</div>
  <p class="pop__ok" id="savedNote" hidden></p>
  <p class="pop__warn" id="uploadPending" hidden></p>
  <p class="pop__p">Every edit you have made, across all steps &mdash; this is the
     <code class="inl">inputs.json</code> that gets uploaded.</p>
  <pre id="json" tabindex="0" role="region" aria-label="Updated parameters file"></pre>

  <div class="pop__h2">Upload it with the CLI</div>
  <p class="pop__p">This page is offline and can&rsquo;t reach the service. Save the file with
     <b>Save changes</b>, then point <code class="inl">--file</code> at it and run:</p>
  <div class="cmd" id="cmd"></div>
  <div class="pop__p" id="cmdHint"></div>
  <div>
    <button class="btn" id="copyBtn">Copy command</button>
    <button class="btn ghost" id="jsonCopy">Copy JSON</button>
    <button class="btn ghost" id="jsonClose">Close</button>
  </div>
</div>

<div class="pop" id="issuePop" role="dialog" aria-modal="true" aria-labelledby="issuePopH">
  <div class="pop__h" id="issuePopH">Inputs still needed</div>
  <p class="pop__p" id="issueCount"></p>
  <div class="issues" id="issueList"></div>
  <div><button class="btn ghost" id="issueClose">Close</button></div>
</div>

<script nonce="__CSP_NONCE__">
