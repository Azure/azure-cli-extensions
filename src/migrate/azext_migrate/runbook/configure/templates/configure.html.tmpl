    aside { border-left: 0; border-top: 1px solid var(--hair); }
    .ov-pane { overflow: visible; padding: 14px; }
    pre { min-height: 220px; max-height: 60vh; }
    .keys { margin-left: 0; }
    .topbar { padding: 12px 14px; }
