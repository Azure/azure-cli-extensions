// User-parameters file name (service renamed inputs.json -> parameters.json;
// the CLI passes the actual name so the shown upload command matches).
const PARAM_FILE = META.parametersFileName || 'inputs.json';
const STEP_ENTITIES = {}, STEP_DISPLAY = {};
(SPEC.workstreams || []).forEach(w => (w.steps || []).forEach(s => {
  STEP_ENTITIES[s.stepId] = s.entities || [];
  if (s.displayName) STEP_DISPLAY[s.stepId] = s.displayName;
