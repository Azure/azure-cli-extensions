// Entities are keyed by their short name in workloadOverrides; the spec carries
// the human-readable label for both the short name and the full ARM id.
const ENTITY_NAMES = {};
(SPEC.entities || []).forEach(e => {
  const key = e.name || e.id, label = e.displayName || key;
